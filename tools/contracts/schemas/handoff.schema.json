{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fractal.local/schemas/handoff.schema.json",
  "title": "Workstream Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "job_id",
    "workstream_id",
    "contract_version",
    "status",
    "produced_by",
    "created_at",
    "summary",
    "checks",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/definitions/version" },
    "handoff_id": { "$ref": "common.schema.json#/definitions/id" },
    "job_id": { "$ref": "common.schema.json#/definitions/id" },
    "workstream_id": { "$ref": "common.schema.json#/definitions/id" },
    "contract_version": { "$ref": "common.schema.json#/definitions/version" },
    "status": {
      "type": "string",
      "enum": ["accepted", "rejected", "blocked", "failed", "cancelled"]
    },
    "produced_by": { "$ref": "common.schema.json#/definitions/principal" },
    "evaluated_by": { "$ref": "common.schema.json#/definitions/principal" },
    "created_at": { "$ref": "common.schema.json#/definitions/timestamp" },
    "summary": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "evidence_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["pass", "fail", "not_run"] },
          "evidence_id": { "$ref": "common.schema.json#/definitions/id" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/id" }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
