{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fractal.local/schemas/common.schema.json",
  "title": "FRACTAL Common Types",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._~/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "risk_tier": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "principal_type"],
      "properties": {
        "principal_id": { "$ref": "#/definitions/id" },
        "principal_type": {
          "type": "string",
          "enum": ["human", "agent", "workload", "service"]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string" },
        "runtime_version": { "type": "string" },
        "delegated_by": { "$ref": "#/definitions/id" }
      }
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "$ref": "#/definitions/version" },
        "uri": { "type": "string", "format": "uri-reference" },
        "content_hash": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
