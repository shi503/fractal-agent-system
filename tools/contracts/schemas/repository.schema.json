{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fractal.local/schemas/repository.schema.json",
  "title": "Repository Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "name",
    "uri",
    "default_branch",
    "owners",
    "classification"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/definitions/version" },
    "repository_id": { "$ref": "common.schema.json#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "uri": { "type": "string", "format": "uri" },
    "default_branch": { "type": "string", "minLength": 1 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/id" }
    },
    "classification": { "$ref": "common.schema.json#/definitions/classification" },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["api", "event", "library", "schema", "ui", "other"]
          },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
