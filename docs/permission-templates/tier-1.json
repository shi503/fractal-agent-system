{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(npm test *)",
