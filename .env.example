# Database — Supabase Postgres via connection pooler (Supavisor)
# Used for all runtime queries (pooled connection)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database — Direct connection (used by Prisma Migrate for schema migrations only)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth) secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# OAuth providers (optional — add the ones you enable)
# AUTH_GITHUB_ID="your-github-oauth-app-client-id"
# AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"
