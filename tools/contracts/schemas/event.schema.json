{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fractal.local/schemas/event.schema.json",
  "title": "FRACTAL Work Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "time", "subject", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "common.schema.json#/definitions/id" },
    "source": { "type": "string", "format": "uri-reference" },
    "type": {
      "type": "string",
      "enum": [
        "fractal.work.accepted",
        "fractal.work.started",
        "fractal.work.action.requested",
        "fractal.work.action.completed",
        "fractal.work.evaluation.completed",
        "fractal.work.blocked",
        "fractal.work.failed",
        "fractal.work.timed_out",
        "fractal.work.cancelled",
        "fractal.work.completed",
        "fractal.work.recovery.completed"
      ]
    },
    "time": { "$ref": "common.schema.json#/definitions/timestamp" },
    "subject": { "$ref": "common.schema.json#/definitions/id" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri-reference" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_id", "workstream_id", "trace_id", "actor", "status"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/definitions/version" },
        "job_id": { "$ref": "common.schema.json#/definitions/id" },
        "workstream_id": { "$ref": "common.schema.json#/definitions/id" },
        "trace_id": { "$ref": "common.schema.json#/definitions/id" },
        "parent_event_id": { "$ref": "common.schema.json#/definitions/id" },
        "actor": { "$ref": "common.schema.json#/definitions/principal" },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "running",
            "blocked",
            "failed",
            "timed_out",
            "cancelled",
            "completed",
            "recovered"
          ]
        },
        "policy_decision_id": { "$ref": "common.schema.json#/definitions/id" },
        "capability_id": { "$ref": "common.schema.json#/definitions/id" },
        "target": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/id" }
        },
        "error_class": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
