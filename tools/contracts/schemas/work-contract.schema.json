{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fractal.local/schemas/work-contract.schema.json",
  "title": "Work Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "job_id",
    "workstream_id",
    "title",
    "outcome",
    "requested_by",
    "risk_tier",
    "scope",
    "context",
    "capabilities",
    "acceptance",
    "constraints",
    "dependencies"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/definitions/version" },
    "contract_version": { "$ref": "common.schema.json#/definitions/version" },
    "job_id": { "$ref": "common.schema.json#/definitions/id" },
    "workstream_id": { "$ref": "common.schema.json#/definitions/id" },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "requested_by": { "$ref": "common.schema.json#/definitions/principal" },
    "assigned_to": { "$ref": "common.schema.json#/definitions/principal" },
    "risk_tier": { "$ref": "common.schema.json#/definitions/risk_tier" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "access", "paths"],
        "properties": {
          "repository_id": { "$ref": "common.schema.json#/definitions/id" },
          "access": { "type": "string", "enum": ["read", "write"] },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "context": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/resource_ref" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/id" }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "evidence_kinds"],
        "properties": {
          "criterion_id": { "$ref": "common.schema.json#/definitions/id" },
          "description": { "type": "string", "minLength": 1 },
          "evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_effects_allowed"],
      "properties": {
        "external_effects_allowed": { "type": "boolean" },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "deadline": { "$ref": "common.schema.json#/definitions/timestamp" },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/id" }
    },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
